{
  "name": "dsh-web-notification",
  "description": "Browser system notifications for the DeepSeek Harness web GUI: turn completion and permission/approval asks.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pd90506/dsh-web-notification.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notifications"
  ]
}
